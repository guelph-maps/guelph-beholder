# Copy to .env and fill in. .env is gitignored.

# Flask session signing key (any long random string).
FLASK_SECRET=change-me-to-a-long-random-string

# OSM OAuth2 application credentials. This beholder shares the Toronto
# beholder's registered app (redirect URI http://127.0.0.1:5000/auth/callback,
# scope read_prefs), so only one of the two can run at a time. Register a
# separate app at https://www.openstreetmap.org/oauth2/applications if you want
# both up at once — then change [auth] redirect_uri and the port you serve on.
OSM_CLIENT_ID=
OSM_CLIENT_SECRET=

# Local development bypass. When BEHOLDER_DEV=1, the /auth/dev-login route is
# registered and logs in as DEV_ADMIN_USER without OSM OAuth. Never set in prod.
BEHOLDER_DEV=1
DEV_ADMIN_USER=dev-admin
